rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authenticated user owns everything under users/{uid}
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
    }

    // Linking-code registry (public read; only the owner may create/delete).
    // The code itself is the secret — anyone who knows it can look up the uid.
    match /linkCodes/{code} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt']);
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Extension may write journal keys when it supplies a valid linking code.
    // The write must include linkCode and the looked-up uid must match the path.
    match /users/{uid}/journal/{docId} {
      allow write: if request.auth != null && request.auth.uid == uid
        || (
          request.resource.data.keys().hasAll(['key', 'value', 'linkCode'])
          && request.resource.data.linkCode is string
          && exists(/databases/$(database)/documents/linkCodes/$(request.resource.data.linkCode))
          && get(/databases/$(database)/documents/linkCodes/$(request.resource.data.linkCode)).data.uid == uid
        );
    }
  }
}
